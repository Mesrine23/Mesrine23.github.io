---
import { Image } from 'astro:assets';
import type { Content } from '../data/types';

interface Props { c: Content; n: number }
const { c, n } = Astro.props;
const pad = String(n).padStart(2, '0');
---
<section id="side-projects" class="shell">
  <div class="section reveal">
    <h2 class="section__label">{pad} / {c.side.label}</h2>

    <div>
      <p class="side__intro">{c.side.intro}</p>

      <ul class="side">
        {c.side.items.map((p) => p.app ? (
          <li class="side-app">
            <div class="side-app__head">
              <Image src={p.app.icon} alt="" widths={[72, 144]} sizes="4.5rem" class="side-app__icon" />
              <div>
                <h3 class="side-app__name">
                  <a href={p.app.storeUrl} target="_blank" rel="noopener noreferrer">{p.name}</a>
                </h3>
                <p class="side-app__meta mono">
                  {p.tags.map((t, i) => <>{i > 0 && ' · '}<span>{t}</span></>)}
                </p>
              </div>
            </div>

            <p class="side-app__blurb">{p.blurb}</p>

            <div class="side-app__shots">
              {p.app.screenshots.map((s) => (
                <Image
                  src={s.src}
                  alt={s.alt}
                  widths={[200, 400]}
                  sizes="(max-width: 30rem) 45vw, 12.5rem"
                  class="side-app__shot"
                />
              ))}
            </div>

            <ul class="side-app__highlights">
              {p.app.highlights.map((h) => (
                <li class="side-app__highlight glass-quiet">
                  <span class="side-app__highlight-name mono">{h.name}</span>
                  <span class="side-app__highlight-note">{h.note}</span>
                </li>
              ))}
            </ul>

            <a class="side-app__cta btn btn--glass glass mono print-url" href={p.app.storeUrl} target="_blank" rel="noopener noreferrer">
              {p.app.storeLabel}
            </a>
          </li>
        ) : (
          <li class="side__item glass">
            <h3 class="side__name">
              {p.href ? <a href={p.href} target="_blank" rel="noopener noreferrer">{p.name}</a> : p.name}
            </h3>
            <p class="side__blurb">{p.blurb}</p>
            <p class="side__tags mono">{p.tags.join(' · ')}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .side__intro { color: var(--text-3); font-size: var(--fs-body); margin-bottom: 1.5rem; }
  .side {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.125rem;
    container-type: inline-size;
  }
  .side__item { display: flex; flex-direction: column; padding: 1.25rem; }
  .side__name { font-size: var(--fs-h3); margin-bottom: 0.4375rem; }
  .side__name a { color: var(--text-strong); }
  .side__name a:hover { color: var(--accent); }
  .side__blurb { font-size: var(--fs-body); line-height: 1.5; color: var(--text-2); margin-bottom: 0.75rem; }
  .side__tags { margin-top: auto; font-size: var(--fs-micro); letter-spacing: 0.04em; color: var(--text-3); }

  /* A released app takes the full row: its story on the left, the screenshots
     beside it. Areas rather than wrappers, so on phones the screenshots can
     move up between the blurb and the details without a second copy in the DOM. */
  .side-app {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto auto auto 1fr;
    grid-template-areas:
      'head       shots'
      'blurb      shots'
      'highlights shots'
      'cta        shots';
    column-gap: clamp(1.75rem, 4vw, 3.5rem);
  }
  .side-app__head { grid-area: head; display: flex; align-items: center; gap: 1.125rem; margin-bottom: 1.125rem; }
  .side-app__icon {
    flex-shrink: 0;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 22.5%;     /* the iOS icon mask, near enough */
    box-shadow: 0 0 0 1px var(--glass-border), 0 16px 36px -18px var(--accent);
  }
  .side-app__name { font-size: var(--fs-h2); letter-spacing: -0.02em; }
  .side-app__name a { color: var(--text-strong); }
  .side-app__name a:hover { color: var(--accent); }
  .side-app__meta { font-size: var(--fs-2xs); color: var(--text-2); margin-top: 0.25rem; }
  /* wrap between tags, never inside one ("English & / Greek") */
  .side-app__meta span { white-space: nowrap; }
  .side-app__blurb {
    grid-area: blurb;
    font-size: var(--fs-body-lg);
    line-height: 1.6;
    color: var(--text-2);
    max-width: 36rem;
    margin-bottom: 1.5rem;
  }

  .side-app__shots { grid-area: shots; display: flex; gap: 0.875rem; align-items: flex-start; }
  .side-app__shot {
    display: block;
    width: 12.5rem;
    height: auto;
    border-radius: 14% / 6.45%;   /* a screen's corners, at any size */
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-drop);
  }

  .side-app__highlights {
    grid-area: highlights;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.75rem;
  }
  .side-app__highlight { display: flex; flex-direction: column; gap: 0.375rem; padding: 1rem 1.125rem; }
  .side-app__highlight-name { font-size: var(--fs-xs); color: var(--text); }
  .side-app__highlight-note { font-size: var(--fs-xs); line-height: 1.45; color: var(--text-3); }

  .side-app__cta { grid-area: cta; justify-self: start; align-self: start; }

  @media (max-width: 60rem) { .side { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 44rem) { .side { grid-template-columns: minmax(0, 1fr); } }

  /* Container queries, not media queries: on desktop the section label takes
     a column beside this one, so the viewport says little about the room the
     feature actually has. Below 56rem the text column would squeeze the
     highlight names onto two lines, so everything stacks instead. */
  @container (max-width: 56rem) {
    .side-app {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-template-areas: 'head' 'blurb' 'shots' 'highlights' 'cta';
    }
    .side-app__shots { margin-bottom: 1.5rem; }
    .side-app__shot { width: calc((100% - 0.875rem) / 2); max-width: 12.5rem; }
  }
  @container (max-width: 30rem) { .side-app__highlights { grid-template-columns: minmax(0, 1fr); } }
</style>
