---
import type { Content } from '../data/types';
interface Props { c: Content; n: number }
const { c, n } = Astro.props;
const pad = String(n).padStart(2, '0');
const os = c.openSource;
---
<section id="open-source" class="shell">
  <div class="section reveal">
    <h2 class="section__label">{pad} / {os.label}</h2>

    <div class="os__body">
      <div class="os__head">
        <h3 class="os__name mono">
          <a href={os.repoUrl} target="_blank" rel="noopener noreferrer">{os.name}</a>
        </h3>
        <span class="os__meta mono">{os.meta}</span>
      </div>

      <p class="os__blurb">{os.blurb}</p>

      <figure class="code-panel glass">
        <figcaption class="code-panel__bar">
          <span class="code-panel__dot" aria-hidden="true"></span>
          <span class="code-panel__dot" aria-hidden="true"></span>
          <span class="code-panel__dot" aria-hidden="true"></span>
          <span class="code-panel__name mono">{os.codeCaption}</span>
        </figcaption>
        <pre class="code-panel__code mono"><code>{os.code}</code></pre>
      </figure>

      <ul class="os__products">
        {os.products.map((p) => (
          <li class="os__product glass-quiet">
            <span class="os__product-name mono">{p.name}</span>
            <span class="os__product-note">{p.note}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .os__body { max-width: 56rem; }
  .os__head { display: flex; align-items: baseline; flex-wrap: wrap; gap: 1rem; margin-bottom: 0.875rem; }
  .os__name { font-size: var(--fs-h2); font-weight: 700; letter-spacing: -0.01em; }
  .os__name a { color: var(--text-strong); }
  .os__name a:hover { color: var(--accent); }
  .os__meta { font-size: var(--fs-2xs); color: var(--text-2); }
  .os__blurb {
    font-size: var(--fs-body-lg);
    line-height: 1.6;
    color: var(--text-2);
    max-width: 45rem;
    margin-bottom: 1.625rem;
  }

  .code-panel { margin: 0 0 1.375rem; }
  .code-panel__bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
  }
  .code-panel__dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
  }
  .code-panel__name { font-size: var(--fs-micro); color: var(--text-2); margin-left: 0.625rem; }
  .code-panel__code {
    margin: 0;
    padding: 1.375rem 1.5rem;
    font-size: var(--fs-xs);
    line-height: 1.75;
    color: var(--text-2);
    overflow-x: auto;
  }

  .os__products {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .os__product { display: flex; flex-direction: column; gap: 0.375rem; padding: 1rem 1.125rem; }
  .os__product-name { font-size: var(--fs-xs); color: var(--text); }
  .os__product-note { font-size: var(--fs-xs); line-height: 1.45; color: var(--text-3); }


  @media (max-width: 60rem) { .os__products { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 34rem) { .os__products { grid-template-columns: minmax(0, 1fr); } }
</style>
