---
import type { Content } from '../data/types';
interface Props { c: Content }
const { c } = Astro.props;
---
<section class="shell">
  <dl class="facts">
    {c.facts.map((f) => (
      <div class="facts__cell">
        <dt class="facts__label mono">{f.label}</dt>
        <dd class="facts__value mono">{f.value}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  /* Deliberately flat and hairline — the one place the terminal shows through
     undisguised. Making this glass too would tip the page into all-glass. */
  .facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .facts__cell { padding: 1.5rem 1.75rem; }
  .facts__cell + .facts__cell { border-left: 1px solid var(--rule); }
  .facts__cell:first-child { padding-left: 0; }
  .facts__cell:last-child { padding-right: 0; }
  .facts__label {
    font-size: var(--fs-micro);
    letter-spacing: 0.12em;
    color: var(--text-3);
    margin-bottom: 0.5625rem;
  }
  .facts__value { margin: 0; font-size: var(--fs-body); color: var(--text); }

  @media (max-width: 52rem) {
    .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .facts__cell { padding: 1.125rem 1.25rem; }
    .facts__cell:nth-child(odd)  { padding-left: 0; border-left: 0; }
    .facts__cell:nth-child(even) { padding-right: 0; }
    .facts__cell:nth-child(n + 3) { border-top: 1px solid var(--rule-soft); }
  }
</style>
