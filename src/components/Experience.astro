---
import type { Content } from '../data/types';
interface Props { c: Content; n: number }
const { c, n } = Astro.props;
const pad = String(n).padStart(2, '0');
---
<section id="experience" class="shell">
  <div class="section reveal">
    <h2 class="section__label">{pad} / {c.experience.label}</h2>

    <ol class="roles">
      {c.experience.roles.map((r) => (
        <li class="role">
          <div class="role__head">
            <h3 class="role__company">{r.company}</h3>
            <span class="role__period mono">{r.period}</span>
          </div>
          <p class="role__title mono">{r.title} · {r.location}</p>
          {r.summary && <p class="role__summary">{r.summary}</p>}
          {r.bullets.length > 0 && (
            <ul class="role__bullets">
              {r.bullets.map((b) => <li>{b}</li>)}
            </ul>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .roles { display: flex; flex-direction: column; max-width: var(--measure); }
  .role { padding: 1.5rem 0; border-top: 1px solid var(--rule-soft); }
  .role:first-child { border-top: 0; padding-top: 0; }
  .role__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .role__company { font-size: var(--fs-h3); }
  .role__period { font-size: var(--fs-2xs); color: var(--text-3); letter-spacing: 0.04em; }
  .role__title {
    font-size: var(--fs-xs);
    color: var(--accent);
    letter-spacing: 0.04em;
    margin: 0.4375rem 0 0.75rem;
  }
  .role__summary { font-size: var(--fs-body); line-height: 1.6; color: var(--text-2); margin-bottom: 0.75rem; }
  .role__bullets { display: flex; flex-direction: column; gap: 0.5rem; }
  .role__bullets li {
    position: relative;
    padding-left: 1.125rem;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--text-2);
  }
  .role__bullets li::before { content: '—'; position: absolute; left: 0; color: var(--text-3); }
</style>
