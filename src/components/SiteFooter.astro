---
import type { Content } from '../data/types';
import { encodeEmail, humanEmail } from '../lib/email';

interface Props { c: Content }
const { c } = Astro.props;
const f = c.footer;

const year = new Date().getFullYear();
const emailEncoded = encodeEmail(f.email);
const fallback = humanEmail(f.email);
---
<footer id="contact" class="foot">
  <div class="shell">
    <div class="foot__top">
      <div class="foot__who">
        <p class="foot__name">Panagiotis Palamidas</p>
        <p class="foot__role mono">{f.role}</p>
      </div>

      <ul class="foot__links mono">
        <li><a class="foot__link" href="#contact" data-email={emailEncoded}>{f.emailLabel}</a></li>
        {f.links.map((l) => (
          <li><a class="foot__link print-url" href={l.href} rel="me noopener">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <noscript>
      <p class="foot__fallback mono">{fallback}</p>
    </noscript>

    <div class="foot__bar mono">
      <p>© {year} Panagiotis Palamidas</p>
      <p>{f.updated}</p>
    </div>
  </div>
</footer>

<style>
  .foot {
    margin-top: clamp(3.5rem, 7vw, 5rem);
    border-top: 1px solid var(--rule);
  }
  .foot__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 3rem;
    flex-wrap: wrap;
    padding-top: clamp(2rem, 4vw, 2.75rem);
    padding-bottom: clamp(1.25rem, 2vw, 1.75rem);
  }
  .foot__name { font-size: var(--fs-h3); color: var(--text-strong); font-weight: 700; }
  .foot__role { font-size: var(--fs-2xs); color: var(--text-3); margin-top: 0.375rem; letter-spacing: 0.04em; }

  .foot__links { display: flex; flex-wrap: wrap; align-items: center; gap: 0 1.75rem; }
  .foot__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;      /* 44px hit target */
    font-size: var(--fs-xs);
    color: var(--text-2);
    letter-spacing: 0.04em;
  }
  .foot__link:hover { color: var(--accent); }

  .foot__fallback { font-size: var(--fs-xs); color: var(--text-2); padding-bottom: 1rem; }

  .foot__bar {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    flex-wrap: wrap;
    padding-block: 1.25rem;
    border-top: 1px solid var(--rule-soft);
    font-size: var(--fs-2xs);
    color: var(--text-3);
  }
  .foot__bar p { margin: 0; }

  @media (max-width: 44rem) {
    .foot__top { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
  }
</style>
